      "parameters": {
        "resource": "email",
        "operation": "sendAndWait",
        "fromEmail": "={{ $('Invoice Data').first().json.senderAddress }}",
        "toEmail": "={{ $('Invoice Data').first().json.approver }}",
        "subject": "=Approval needed: invoice {{ $('Invoice Data').first().json.invoiceNumber }} from {{ $('Invoice Data').first().json.vendor }}",
        "message": "=Please approve or decline the following invoice.\n\nInvoice number: {{ $('Invoice Data').first().json.invoiceNumber }}\nVendor: {{ $('Invoice Data').first().json.vendor }} ({{ $('Invoice Data').first().json.senderEmail }})\nAmount: {{ $('Invoice Data').first().json.amount }} EUR\nCost center: {{ $('Invoice Data').first().json.costCenter }}\n\nThe original email stays in the invoice mailbox; attach or link it from your DMS as your process requires.",
        "responseType": "approval",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Approve",
            "disapproveLabel": "Decline"
          }
        },
        "options": {
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": "={{ $('Invoice Data').first().json.reminderDays }}",
              "resumeUnit": "days"
            }
          },
          "appendAttribution": false
        }
      },
      "onError": "continueErrorOutput"
    },
