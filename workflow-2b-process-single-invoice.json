        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "0be960b1",
              "leftValue": "={{ $json.needsReview }}",
              "operator": {
